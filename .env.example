# ===========================================
# Cognitive State Protocol - Environment Config
# ===========================================

# Database (Railway provides this automatically)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/cognitive_state

# Redis (optional - Railway Redis or leave empty)
REDIS_URL=redis://localhost:6379/0

# Gemini API (required)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: Override default models
# GEMINI_PRO_MODEL=gemini-3-pro-preview
# GEMINI_FLASH_MODEL=gemini-3-flash-preview

# Auth - MUST change for production!
SECRET_KEY=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS - Set to your Vercel frontend URL for production
# Example: https://your-app.vercel.app
# For multiple origins: https://app.example.com,https://www.example.com
CORS_ORIGINS=*

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./media

# Optional: AWS S3 for media storage (recommended for production)
# STORAGE_BACKEND=s3
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=us-east-1
# STORAGE_BUCKET=cognitive-state-media

# Google OAuth (for Google Docs integration)
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
# GOOGLE_REDIRECT_URI=https://your-app.vercel.app/auth/google/callback

# Debug - set to false in production
DEBUG=true
